{
    "name": "chrisreedio/laravel-mdstaff-sdk",
    "description": "Laravel SDK for querying the MDStaff (ASM Cloud) API",
    "keywords": [
        "Chris Reed",
        "laravel",
        "mdstaff",
        "saloon",
        "laravel-mdstaff-sdk"
    ],
    "homepage": "https://github.com/chrisreedio/laravel-mdstaff-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Reed",
            "email": "chris@reedtech.us",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "saloonphp/cache-plugin": "^3.0",
        "saloonphp/pagination-plugin": "^2.0",
        "saloonphp/rate-limit-plugin": "^2.0",
        "saloonphp/saloon": "^3.10||^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0||^10.0||^9.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ChrisReedIO\\MDStaff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisReedIO\\MDStaff\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChrisReedIO\\MDStaff\\MDStaffServiceProvider"
            ],
            "aliases": {
                "MDStaff": "ChrisReedIO\\MDStaff\\Facades\\MDStaff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
